---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies, type CaseStudy } from "../../data/case-studies";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const index = caseStudies.findIndex((item) => item.slug === study.slug);
const next = caseStudies[(index + 1) % caseStudies.length];
const siteUrl = Astro.site ?? new URL("https://giuseppesasso.com.br");
const pageUrl = new URL(`/projetos/${study.slug}/`, siteUrl).toString();

// Breadcrumb para buscadores: Projetos > Estudo de caso
const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Projetos", item: new URL("/projetos/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: study.title, item: pageUrl }
    ]
  }
];
---

<BaseLayout title={study.seoTitle} description={study.seoDescription} schema={schema}>
  <article class="case">
    <nav class="case__breadcrumb" aria-label="Você está em">
      <a href="/projetos/">Projetos</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{study.title}</span>
    </nav>

    <header class="case-hero">
      <div class="case-hero__heading-row">
        <span class="case-hero__number">{study.number}</span>
        <span class:list={["case-badge", `case-badge--${study.statusTone}`]}>{study.status}</span>
      </div>
      <p class="case-hero__meta">Estudo de caso · {study.category}</p>
      <h1 class="case-hero__title">{study.title}</h1>
      <p class="case-hero__lead">{study.lead}</p>
      <div class="button-row">
        {study.links.map((link) =>
          link.badge ? (
            <a class="case-badge-link" href={link.href} target="_blank" rel="noopener noreferrer">
              <img src={link.badge.src} alt={link.label} width={link.badge.width} height={link.badge.height} />
            </a>
          ) : (
            <a
              class:list={["button", link.primary ? "button--primary" : "case-button-secondary"]}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          )
        )}
      </div>
    </header>

    <div class="case-media">
      <div class:list={["case-media__frame", `case-media__frame--${study.image.fit ?? "cover-left"}`]}>
        <img src={study.image.src} alt={study.image.alt} width={study.image.width} height={study.image.height} fetchpriority="high" />
      </div>
    </div>

    <div class="case-layout">
      <aside class="case-facts" aria-label="Ficha do projeto">
        <dl>
          {study.facts.map((fact) => (
            <div class="case-facts__item">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
        <p class="case-facts__label">Stack</p>
        <ul class="case-tags" aria-label={`Stack do ${study.title}`}>
          {study.stack.map((tag) => <li>{tag}</li>)}
        </ul>
        <p class="case-facts__label">Nesta página</p>
        <ul class="case-toc">
          {study.sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.eyebrow}</a></li>
          ))}
        </ul>
      </aside>

      <div class="case-content">
        {study.sections.map((section) => (
          <section id={section.id} class="case-section" aria-labelledby={`${section.id}-title`}>
            <p class="eyebrow">{section.eyebrow}</p>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            {section.cards && (
              <div class="case-cards">
                {section.cards.map((card) => (
                  <div class="case-card">
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </div>
                ))}
              </div>
            )}
            {section.paragraphs?.map((paragraph) => <p class="case-section__text">{paragraph}</p>)}
            {section.list && (
              <ul class="case-list">
                {section.list.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>

    <footer class="case-footer">
      <a class="case-footer__back" href="/projetos/">← Todos os projetos</a>
      <a class="case-footer__next" href={`/projetos/${next.slug}/`}>
        <span class="case-footer__next-label">Próximo estudo de caso</span>
        <span class="case-footer__next-title">{next.title} →</span>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .case {
    width: 100%;
    max-width: var(--container);
    box-sizing: border-box;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 56px) var(--gutter) clamp(64px, 10vw, 112px);
  }

  .case__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(28px, 5vw, 44px);
    color: var(--color-text-tertiary);
    font-size: 14px;
  }

  .case__breadcrumb a {
    color: var(--color-text-secondary);
  }

  .case__breadcrumb a:hover {
    color: var(--color-cyan-hover);
  }

  .case__breadcrumb [aria-current="page"] {
    color: var(--color-text-raised);
  }

  .case-hero {
    max-width: 760px;
  }

  .case-hero__heading-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .case-hero__number {
    color: oklch(0.82 0.11 210 / .45);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 28px;
    font-weight: 700;
  }

  .case-badge {
    display: inline-block;
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .case-badge--cyan {
    border: 1px solid oklch(0.82 0.11 210 / .32);
    background: oklch(0.82 0.11 210 / .12);
    color: var(--color-cyan);
  }

  .case-badge--gold {
    border: 1px solid oklch(0.84 0.1 80 / .3);
    background: oklch(0.84 0.1 80 / .12);
    color: var(--color-gold);
  }

  .case-hero__meta {
    margin: 0 0 10px;
    color: var(--color-cyan);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .case-hero__title {
    margin: 0 0 18px;
    font-size: clamp(30px, 4.6vw, 50px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -.025em;
    text-wrap: pretty;
  }

  .case-hero__lead {
    max-width: 62ch;
    margin: 0 0 26px;
    color: var(--color-text-secondary);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .case-button-secondary {
    border: var(--border-control);
    color: var(--color-text);
  }

  .case-button-secondary:hover {
    border-color: rgba(255, 255, 255, .3);
    color: var(--color-text);
  }

  /* Selo oficial da Chrome Web Store: exibido sem alterações, apenas no tamanho original */
  .case-badge-link {
    display: inline-flex;
    border-radius: 8px;
    transition: opacity var(--transition-fast);
  }

  .case-badge-link:hover {
    opacity: .85;
  }

  .case-badge-link img {
    display: block;
    width: 206px;
    height: auto;
  }

  .case-media {
    margin: clamp(36px, 6vw, 56px) 0;
  }

  .case-media__frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 18px;
    background: #0e1013;
    box-shadow: 0 18px 44px rgba(0, 0, 0, .4);
  }

  .case-media__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .case-media__frame--cover-right img {
    object-position: right top;
  }

  .case-media__frame--contain img {
    object-fit: contain;
    object-position: center;
  }

  .case-layout {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .case-facts {
    position: sticky;
    top: 96px;
    padding: 20px;
    border: var(--border-card);
    border-radius: var(--radius-card);
    background: var(--color-surface-3);
  }

  .case-facts dl {
    margin: 0 0 18px;
  }

  .case-facts__item + .case-facts__item {
    margin-top: 14px;
  }

  .case-facts dt,
  .case-facts__label {
    margin: 0 0 4px;
    color: var(--color-text-tertiary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .case-facts dd {
    margin: 0;
    color: var(--color-text-raised);
    font-size: 14px;
    line-height: 1.5;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 6px 0 18px;
    padding: 0;
    list-style: none;
  }

  .case-tags li {
    padding: 3px 9px;
    border: var(--border-card);
    border-radius: 7px;
    background: var(--color-surface-5);
    color: var(--color-text-raised);
    font-size: 12px;
  }

  .case-toc {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .case-toc li + li {
    margin-top: 6px;
  }

  .case-toc a {
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .case-toc a:hover {
    color: var(--color-cyan-hover);
  }

  .case-section {
    scroll-margin-top: 96px;
  }

  .case-section + .case-section {
    margin-top: clamp(44px, 7vw, 68px);
    padding-top: clamp(44px, 7vw, 68px);
    border-top: var(--border-subtle);
  }

  .case-section h2 {
    margin: 0 0 18px;
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.015em;
    text-wrap: pretty;
  }

  .case-section__text,
  .case-list {
    max-width: 68ch;
    color: var(--color-text-secondary);
    font-size: 16px;
    line-height: 1.7;
  }

  .case-section__text {
    margin: 0 0 14px;
    text-wrap: pretty;
  }

  .case-list {
    margin: 0;
    padding-left: 20px;
  }

  .case-list li + li {
    margin-top: 10px;
  }

  .case-list li::marker {
    color: var(--color-cyan);
  }

  .case-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin: 0 0 20px;
  }

  .case-card {
    padding: 18px;
    border: var(--border-card);
    border-radius: 14px;
    background: var(--color-surface-3);
  }

  .case-card h3 {
    margin: 0 0 8px;
    color: var(--color-text);
    font-size: 16px;
    font-weight: 600;
  }

  .case-card p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }

  .case-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: clamp(56px, 9vw, 96px);
    padding-top: 28px;
    border-top: var(--border-subtle);
  }

  .case-footer__back {
    color: var(--color-text-secondary);
    font-size: 15px;
  }

  .case-footer__next {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
  }

  .case-footer__next-label {
    color: var(--color-text-tertiary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .case-footer__next-title {
    color: var(--color-cyan);
    font-size: 18px;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .case-layout {
      grid-template-columns: 1fr;
    }

    .case-facts {
      position: static;
    }
  }
</style>
